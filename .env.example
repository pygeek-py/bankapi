# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored and loaded automatically in mysite/settings.py.

# Fernet key used to encrypt each user's wallet private key on signup.
# Must be EXACTLY 32 characters long (see api/serializers.py).
DJANGO_ENCRYPTION_KEY=

# Blockchain settings used by api/services/blockchain.py
# JSON-RPC endpoint URL (e.g. an Infura/Alchemy https URL)
WEB3_PROVIDER=
# Backend wallet that signs vault transactions
BACKEND_ADDRESS=
BACKEND_PRIVATE_KEY=
# Deployed TokenVault contract address
VAULT_CONTRACT_ADDRESS=

# Optional: override the email backend during local development so waitlist
# confirmation emails print to the console instead of being sent over SMTP.
# Leave unset in production (defaults to SMTP).
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
